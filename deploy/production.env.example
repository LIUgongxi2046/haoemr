# HaoEMR production configuration contract.
# This file contains references only. Never commit the target secret values.

SPRING_PROFILES_ACTIVE=prod
HAOEMR_DEPLOYMENT_ID=hospital-a-prod
HAOEMR_DATA_RESIDENCY=ON_PREM_ONLY

HAOEMR_DB_URL=jdbc:postgresql://database.internal:5432/haoemr
HAOEMR_DB_USER=haoemr_app
HAOEMR_DB_PASSWORD_REF=env://HAOEMR_DB_PASSWORD

HAOEMR_OIDC_ISSUER_URI=https://idp.hospital.example/oidc
HAOEMR_OIDC_AUDIENCE=haoemr-clinical
HAOEMR_OIDC_REQUIRED_ACR=urn:haoemr:acr:mfa
HAOEMR_OIDC_MFA_REQUIRED=true

HAOEMR_CA_BASE_URI=https://ca.hospital.example/api
HAOEMR_TIMESTAMP_URI=https://tsa.hospital.example/api
HAOEMR_CA_CLIENT_CERTIFICATE_REF=file:///run/secrets/haoemr_ca_client_certificate
HAOEMR_CA_PRIVATE_KEY_REF=file:///run/secrets/haoemr_ca_private_key
HAOEMR_CA_TRUST_ANCHOR_REF=file:///run/secrets/haoemr_ca_trust_anchor

HAOEMR_KMS_KEY_URI=kms://hospital-kms/haoemr-master
HAOEMR_DATABASE_ENCRYPTION_KEY_REF=file:///run/secrets/haoemr_database_encryption_key
HAOEMR_OBJECT_ENCRYPTION_KEY_REF=file:///run/secrets/haoemr_object_encryption_key

HAOEMR_OBJECT_STORAGE_ENDPOINT=https://objects.hospital.example
HAOEMR_OBJECT_STORAGE_BUCKET=haoemr-records
HAOEMR_OBJECT_STORAGE_ACCESS_KEY_REF=file:///run/secrets/haoemr_object_storage_access_key
HAOEMR_OBJECT_STORAGE_SECRET_KEY_REF=file:///run/secrets/haoemr_object_storage_secret_key
HAOEMR_OBJECT_STORAGE_LOCK_REQUIRED=true

HAOEMR_INTEGRATION_TRUSTSTORE_REF=file:///run/secrets/haoemr_integration_truststore
HAOEMR_INTEGRATION_CLIENT_CERTIFICATE_REF=file:///run/secrets/haoemr_integration_client_certificate

# AI remains disabled until A01 and the model harness gates are verified.
HAOEMR_AI_ENABLED=false
HAOEMR_AI_BASE_URI=
HAOEMR_AI_MODEL_ID=
HAOEMR_AI_API_KEY_REF=
HAOEMR_AI_RESIDENCY=ON_PREM_ONLY
