{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "product": "haoemr",
    "module": "ai-medical-assistant-v2",
    "version": "0.1.0",
    "status": "created",
    "inherits": "../tokens.json",
    "direction": "A-clinical-trust-blue"
  },
  "color": {
    "agent": {
      "encounter": {"base": "#1769E0", "surface": "#EAF3FF", "text": "#115CBD"},
      "document": {"base": "#6D45C2", "surface": "#F5F0FF", "text": "#56359C"},
      "recordQc": {"base": "#B7791F", "surface": "#FFF8E7", "text": "#76500B"},
      "result": {"base": "#087F8C", "surface": "#EAF7F7", "text": "#086773"},
      "care": {"base": "#168C64", "surface": "#EAF8F1", "text": "#126B4E"}
    },
    "taskState": {
      "active": {"base": "#1769E0", "surface": "#EAF3FF"},
      "candidate": {"base": "#6D45C2", "surface": "#F5F0FF"},
      "partial": {"base": "#B7791F", "surface": "#FFF8E7"},
      "blocked": {"base": "#C53030", "surface": "#FFF1F1"},
      "stale": {"base": "#526275", "surface": "#EEF2F5"}
    }
  },
  "layout": {
    "launcherMinTarget": "44px",
    "sidePanelWidth": "420px",
    "sidePanelWidthWide": "480px",
    "drawerWidth": "min(720px, 92vw)",
    "workspaceRail": "360px",
    "workspaceContentMax": "1180px",
    "sourceDrawerWidth": "min(720px, 92vw)",
    "taskStripMaxActions": 3
  },
  "component": {
    "taskStrip": {"minHeight": "64px", "maxHeight": "88px", "gap": "8px", "borderWidth": "1px"},
    "taskStep": {"minHeight": "56px", "iconSize": "20px", "gap": "12px"},
    "childAgentCard": {"minHeight": "104px", "iconSize": "24px", "gap": "12px", "handoffGap": "8px"},
    "contributionBadge": {"height": "28px", "radius": "7px", "maxLines": 1},
    "sourceChip": {"height": "28px", "radius": "7px", "maxVisible": 5},
    "candidateHeader": {"minHeight": "72px", "statusRail": "4px"},
    "technicalDetail": {"codeFont": "SFMono-Regular, Consolas, Liberation Mono, monospace"}
  },
  "motion": {
    "panelEnter": "160ms",
    "stepPulse": "1500ms",
    "reduced": "0ms"
  },
  "breakpoint": {
    "drawer": "1280px",
    "widePanel": "1600px"
  }
}
